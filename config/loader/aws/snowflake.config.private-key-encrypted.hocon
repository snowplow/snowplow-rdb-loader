{
  "license": {
    "accept": true
  }
  "messageQueue": "test-queue",
  "storage" : {
    "type": "snowflake",

    "snowflakeRegion": "us-west-2",
    "username": "admin",
    "privateKey": {
      "secretStore": {
        "parameterName": "snowplow.snowflake.private-key"
      }
    },
    "passphrase": {
      "secretStore": {
        "parameterName": "snowplow.snowflake.passphrase"
      }
    },
    "account": "acme",
    "warehouse": "wh",
    "schema": "atomic",
    "database": "snowplow",

    "transformedStage": "snowplow_stage"
  }
}
